#!/usr/bin/env bash

set -e

thisdir=$(cd $(dirname $0) && pwd -P)
workdir=$(mktemp -d)
image=mycodex-image

USER=$(whoami)
USER_ID=$(id -u)
GROUP_ID=$(id -g)

cat << EOF > ${workdir}/build.sh
#!/usr/bin/env bash

set -e

# Delete default ubuntu user
if [[ \$(cat /etc/group) == *"ubuntu"* ]]; then
  userdel ubuntu
fi

# Create a user with same
# permissions as host user
groupadd -g ${GROUP_ID} ${USER}
useradd -l -u ${USER_ID} -g ${USER} ${USER}
install -d -m 0755 -o ${USER} -g ${USER} /home/${USER}

# Install codex and basic utilities
apt update -y
apt install -y sudo nodejs npm git ripgrep build-essential bubblewrap curl
npm i -g @openai/codex
echo "Installed codex \$(codex --version)"

# Install micromamba and a base environment
mkdir /micromamba
pushd /micromamba
curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xvj bin/micromamba
export MAMBA_ROOT_PREFIX=/micromamba
export PATH=/micromamba/bin/:$PATH
micromamba install -y -p /micromamba python=3.14 pytest pytest-cov coverage numpy scipy matplotlib, nibabel, scikit-learn fslpy
popd

# Install default prompt
EOF



cat << EOF > ${workdir}/Dockerfile
FROM ubuntu:24.04
ADD build.sh /
RUN bash /build.sh && rm /build.sh
ENV MAMBA_ROOT_PREFIX "/micromamba"
ENV PATH              "/micromamba/bin/:${PATH}"
USER ${USER}
EOF

cat ${workdir}/build.sh
cat ${workdir}/Dockerfile

TAG="$(date +%Y%m%d%H%M%S)"

docker build               \
  -t "${image}:${TAG}"     \
  -f ${workdir}/Dockerfile \
  ${workdir}

docker tag "${image}:${TAG}" "${image}:latest"

rm -r ${workdir}
