#!/usr/bin/env bash

set -e

thisdir=$(cd $(dirname $0) && pwd -P)
workdir=$(pwd)
image=mycodex-image

if [ "$#" -eq 1 ]; then
    args=()
else
    args="$@"
fi

# check for codex updates, rebuild
# image if a new version is available
installed="None"
available="New"
if [[ $(docker images) == *"mycodex-image"* ]]; then
  installed=$(docker run --network=host ${image}:latest codex --version)
  installed=$(echo ${installed} | cut -d ' ' -f 2)
  available=$(docker run --network=host ${image}:latest npm view @openai/codex version)
  echo "Installed codex version:  ${installed}"
  echo "Latest available version: ${available}"

fi

if [ ${installed} != ${available} ];  then
  echo -n "New version of codex is available - rebuild image? [Y/n]: "
  read rebuild
  rebuild=$(echo "${rebuild}" | tr "[:upper:]" "[:lower:]")
  if [ "${rebuild}" = "y" ] || [ "${rebuild}" = "" ]; then
    ${thisdir}/build
  fi
fi

# You need to install codex on host and run it
# once and log in, so that the ~/.codex/
# directory is populated with authentication
# information.

echo "Running codex on ${workdir}"

docker run -it                                         \
 -v ${workdir}:/home/paulmc/project                    \
 -v ~/.codex/:/home/paulmc/.codex/                     \
 -v ${thisdir}/AGENTS.md:/home/paulmc/.codex/AGENTS.md \
 --workdir=/home/paulmc/project                        \
 --network=host                                        \
 ${image}:latest                                       \
 codex --dangerously-bypass-approvals-and-sandbox ${args[@]}
